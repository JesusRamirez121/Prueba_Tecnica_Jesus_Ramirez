        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="Katalon_Recorder_Selenium">
          <stringProp name="WebDriverSampler.script">driver.get(&quot;https://test-bpm-bancodeoccidente.bizagi.com/&quot;);
    driver.findElement(By.xpath(&quot;//li[@id=&apos;menuListNew&apos;]/a/span[2]&quot;)).click();
    driver.findElement(By.xpath(&quot;//div[@id=&apos;categories&apos;]/ul/li/span&quot;)).click();
    driver.findElement(By.xpath(&quot;//div[@id=&apos;mVPC_kmOPC_SolicitudCredito_xmOPCS_SolicitantesProdCre&apos;]/div/div[2]/div[3]/table/tbody/tr/th/div/div/ul/li/div&quot;)).click();
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div/div/div/div/div/div/div/div[2]&quot;)).click();
    driver.findElement(By.id(&quot;opt-7&quot;)).click();
    driver.findElement(By.id(&quot;combo-40c8e84d-8fd5-4781-b49a-9a8099091866&quot;)).click();
    driver.findElement(By.id(&quot;opt-1&quot;)).click();
    driver.findElement(By.xpath(&quot;//input[@value=&apos;&apos;]&quot;)).click();
    driver.findElement(By.xpath(&quot;//input[@value=&apos;&apos;]&quot;)).clear();
    driver.findElement(By.xpath(&quot;//input[@value=&apos;&apos;]&quot;)).sendKeys(&quot;12345678&quot;);
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[3]/div/div/div/div/div/input&quot;)).clear();
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[3]/div/div/div/div/div/input&quot;)).sendKeys(&quot;Prueba&quot;);
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[4]/div/div/div/div/div/input&quot;)).clear();
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[4]/div/div/div/div/div/input&quot;)).sendKeys(&quot;prueba&quot;);
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[5]/div/div/div/div/div/input&quot;)).clear();
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[5]/div/div/div/div/div/input&quot;)).sendKeys(&quot;3125469874&quot;);
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[5]/div[2]/div/div/div/div/input&quot;)).clear();
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[5]/div[2]/div/div/div/div/input&quot;)).sendKeys(&quot;prueba@banco.com&quot;);
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[6]/div/div/div/div/div/div/div[2]&quot;)).click();
    driver.findElement(By.id(&quot;opt-1&quot;)).click();
    driver.findElement(By.xpath(&quot;//div[@id=&apos;ui-id-3&apos;]/div/div/div/div/div[7]/div/div/div/div/div/div/div[2]/i&quot;)).click();
    driver.findElement(By.id(&quot;opt-1&quot;)).click();
    driver.findElement(By.id(&quot;combo-5f91d5e8-a0ba-494c-b7d3-ecb3c26e536b&quot;)).click();
    driver.findElement(By.id(&quot;opt-2&quot;)).click();
    driver.findElement(By.xpath(&quot;(.//*[normalize-space(text()) and normalize-space(.)=&apos;Debe revisar lo siguiente:&apos;])[2]/following::span[1]&quot;)).click();
</stringProp>
          <stringProp name="WebDriverSampler.parameters"></stringProp>
          <stringProp name="WebDriverSampler.language">groovy</stringProp>
        </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
        <hashTree/>
        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="Katalon_Recorder_Selenium">
          <stringProp name="WebDriverSampler.script">//WDS.sampleResult.sampleStart()
//WDS.browser.get(&apos;https://test-bpm-bancodeoccidente.bizagi.com/&apos;)
//WDS.sampleResult.sampleEnd
WDS.sampleResult.sampleStart();
WDS.browser.get(&quot;https://test-bpm-bancodeoccidente.bizagi.com/&quot;);
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;userName&quot;)).click();
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;userName&quot;)).clear();
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;userName&quot;)).sendKeys(&quot;jesus&quot;);
//WDS.browser.findElement(org.openqa.selenium.By.id(&quot;userEmail&quot;)).click();
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;userEmail&quot;)).clear();
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;userEmail&quot;)).sendKeys(&quot;jesusramirez1087@gmail.com&quot;);
//WDS.browser.findElement(org.openqa.selenium.By.id(&quot;currentAddress&quot;)).click();
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;currentAddress&quot;)).clear();
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;currentAddress&quot;)).sendKeys(&quot;Demo de la direccion uno&quot;);
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;permanentAddress&quot;)).clear();
WDS.browser.findElement(org.openqa.selenium.By.id(&quot;permanentAddress&quot;)).sendKeys(&quot;Demo de la direccion dos&quot;);
WDS.sampleResult.sampleEnd();
</stringProp>
          <stringProp name="WebDriverSampler.parameters"></stringProp>
          <stringProp name="WebDriverSampler.language">groovy</stringProp>
        </com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler>
        <hashTree/>
